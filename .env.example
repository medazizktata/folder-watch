# folder-watch local configuration.
#
#   cp .env.example .env      # then fill in your own values
#
# .env is gitignored. It holds machine-local paths and account identifiers —
# things that shouldn't live in source but that built-in presets need.
#
# Read from the first of these that exists:
#   $FOLDER_WATCH_ENV
#   ~/.config/folder-watch/.env
#   <repo root>/.env
#
# A real environment variable always overrides the file.
#
# None of this is required. Presets saved in
# ~/.config/folder-watch/presets.json work with no .env at all — these values
# only populate the built-in defaults in folder_watch/presets.py.

# Google account whose CloudStorage mount holds the drive.
# Produces ~/Library/CloudStorage/GoogleDrive-<email>/
FOLDER_WATCH_DRIVE_EMAIL=you@example.com

# Shared-drive target id — the segment after .shortcut-targets-by-id/.
# Leave blank for a personal (non-shared) drive.
FOLDER_WATCH_DRIVE_SHORTCUT_ID=

# --- la-chaise-v1 preset ---
# Watched folder, absolute.
FOLDER_WATCH_LA_CHAISE_SRC=/Users/you/Desktop/project-batch2/Output
# Destination, relative to the drive root resolved above.
FOLDER_WATCH_LA_CHAISE_DEST=Some Client/Project/Output/Videos/V2
